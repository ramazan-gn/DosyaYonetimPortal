@{
    ViewData["Title"] = "Tüm dosyalar";
}

<div class="portal-page-hero mb-4">
    <h1><i class="bi bi-folder-symlink me-2"></i>Tüm dosyalar</h1>
    <p class="mb-0">Yönetici görünümü — tüm yüklemeler.</p>
</div>

<div id="msg" class="alert d-none border-0 shadow-sm"></div>

<div class="portal-table-wrap">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Dosya</th>
                <th>Sahip</th>
                <th>Boyut</th>
                <th>Yüklenme</th>
                <th class="text-end">İşlem</th>
            </tr>
        </thead>
        <tbody id="tbody">
            <tr><td colspan="5" class="text-center text-muted py-5"><span class="spinner-border spinner-border-sm text-primary me-2"></span>Yükleniyor...</td></tr>
        </tbody>
    </table>
</div>

<p class="mt-4">
    <a asp-action="Index" class="portal-back-link"><i class="bi bi-arrow-left-short fs-4 align-middle"></i> Panele dön</a>
</p>

@section Scripts {
    <script>
        $(function () {
            function load() {
                Portal.ajax({ url: Portal.apiUrl('/api/admin/files'), method: 'GET' })
                    .done(function (items) {
                        var $tb = $('#tbody').empty();
                        if (!items.length) {
                            $tb.append('<tr><td colspan="5" class="text-center text-muted py-5"><i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>Kayıt yok.</td></tr>');
                            return;
                        }
                        items.forEach(function (f) {
                            var dt = new Date(f.uploadedAtUtc).toLocaleString('tr-TR');
                            var fn = $('<span>').text(f.originalFileName).html();
                            var ow = $('<span>').text(f.ownerEmail || f.ownerUserId).html();
                            var row = $('<tr>');
                            row.append($('<td>').html('<i class="bi bi-file-earmark-fill text-primary me-2"></i><span class="fw-medium">' + fn + '</span>'));
                            row.append($('<td>').html('<i class="bi bi-person me-1 text-secondary"></i>' + ow));
                            row.append($('<td>').html('<span class="badge rounded-pill bg-info bg-opacity-10 text-dark border border-info border-opacity-25">' + Portal.formatBytes(f.sizeBytes) + '</span>'));
                            row.append($('<td>').text(dt));
                            var btn = $('<button type="button" class="btn btn-sm btn-portal-delete"><i class="bi bi-trash me-1"></i>Sil</button>')
                                .on('click', function () {
                                    if (!confirm('Dosyayı kalıcı olarak silmek istiyor musunuz?')) return;
                                    Portal.ajax({ url: Portal.apiUrl('/api/admin/files/' + f.id), method: 'DELETE' })
                                        .done(function () { load(); })
                                        .fail(function () {
                                            $('#msg').removeClass('d-none').addClass('alert-danger').html('<i class="bi bi-x-circle me-2"></i>Silinemedi.');
                                        });
                                });
                            row.append($('<td class="text-end">').append(btn));
                            $tb.append(row);
                        });
                    })
                    .fail(function () {
                        $('#tbody').html('<tr><td colspan="5" class="text-danger text-center py-4"><i class="bi bi-exclamation-triangle me-2"></i>Liste alınamadı.</td></tr>');
                    });
            }
            if (!Portal.token()) {
                $('#tbody').html('<tr><td colspan="5" class="text-danger py-4"><i class="bi bi-lock-fill me-2"></i>Giriş gerekli.</td></tr>');
                return;
            }
            load();
        });
    </script>
}
