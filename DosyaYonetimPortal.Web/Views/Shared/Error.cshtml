@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="portal-card p-4 p-md-5 text-center">
    <div class="display-1 text-danger mb-3"><i class="bi bi-bug-fill"></i></div>
    <h1 class="h3 fw-bold" style="color: var(--portal-violet);">Bir şeyler ters gitti</h1>
    <p class="text-muted mb-4">İsteğiniz işlenirken sunucuda bir hata oluştu.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small mb-0">
            <strong>İstek kimliği:</strong> <code class="bg-light px-2 py-1 rounded">@Model.RequestId</code>
        </p>
    }

    <hr class="my-4 opacity-25" />
    <a asp-controller="Files" asp-action="Index" class="btn btn-portal-auth px-4">
        <i class="bi bi-house-door-fill me-2"></i>Dosyalara dön
    </a>
</div>
